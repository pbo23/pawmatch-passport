      "html": "<button class=\"ds-btn\">Aanmelden</button>",
      "css": ":root{--canvas:#f2f2f7;--card:#fff;--fill:#f2f2f7;--ink:#1c1c1e;--muted:#5c5c61;--line:#d8d8dd;--blush:#fde8ef;--rasp:#e84b7a;--rasp-ink:#b5174f;--rasp-tint:rgba(232,75,122,.12);--mint:#1d9e75;--mint-ink:#127052;--mint-tint:rgba(29,158,117,.14);--lilac:#7b68ee;--lilac-ink:#4f3fc0;--lilac-tint:rgba(123,104,238,.14);--blue:#007aff;--ease:cubic-bezier(.2,.8,.2,1)} .ds-btn{font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border:0;border-radius:14px;background:var(--rasp);color:#fff;font-weight:700;font-size:19px;line-height:1;cursor:pointer;transition:transform .15s var(--ease),filter .15s}.ds-btn:hover{filter:brightness(.94)}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:3px solid var(--rasp-ink);outline-offset:2px}.ds-btn:disabled{opacity:.4}"
