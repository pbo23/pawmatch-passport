      "css": ":root{--canvas:#f2f2f7;--card:#fff;--fill:#f2f2f7;--ink:#1c1c1e;--muted:#5c5c61;--line:#d8d8dd;--blush:#fde8ef;--rasp:#e84b7a;--rasp-ink:#b5174f;--rasp-tint:rgba(232,75,122,.12);--mint:#1d9e75;--mint-ink:#127052;--mint-tint:rgba(29,158,117,.14);--lilac:#7b68ee;--lilac-ink:#4f3fc0;--lilac-tint:rgba(123,104,238,.14);--blue:#007aff;--ease:cubic-bezier(.2,.8,.2,1)} .ds-nav{font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;display:flex;align-items:center;gap:2px;padding:14px;background:var(--canvas)}.ds-nav a{padding:10px 14px;border-radius:999px;color:var(--ink);text-decoration:none;font-size:15px;font-weight:500}.ds-nav a:hover{background:var(--card)}.ds-nav a:focus-visible{outline:3px solid var(--rasp-ink);outline-offset:2px}.ds-nav .ds-brand{display:inline-flex;align-items:center;gap:10px;margin-right:auto;font-size:19px;font-weight:700;padding:0}.ds-brand:hover{background:none}.ds-logo{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--rasp),var(--lilac))}"
