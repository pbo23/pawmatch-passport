      "css": ":root{--canvas:#f2f2f7;--card:#fff;--fill:#f2f2f7;--ink:#1c1c1e;--muted:#5c5c61;--line:#d8d8dd;--blush:#fde8ef;--rasp:#e84b7a;--rasp-ink:#b5174f;--rasp-tint:rgba(232,75,122,.12);--mint:#1d9e75;--mint-ink:#127052;--mint-tint:rgba(29,158,117,.14);--lilac:#7b68ee;--lilac-ink:#4f3fc0;--lilac-tint:rgba(123,104,238,.14);--blue:#007aff;--ease:cubic-bezier(.2,.8,.2,1)} .ds-chip{font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;display:inline-flex;align-items:center;gap:8px;margin:4px;padding:9px 15px;border-radius:999px;background:var(--card);color:var(--ink);font-size:15px;font-weight:600}.ds-chip i{width:10px;height:10px;border-radius:50%}"
